# --- Dane finansowe: nigdy w repozytorium ---
# Wyciągi bankowe (iPKO eksportuje XML/CSV/HTML/XLS) i kopie bazy
*.xml
*.csv
*.xls
*.xlsx
*.dump
backups/
# Syntetyczne fixture'y testowe są dozwolone
!tests/fixtures/**/*.xml
!tests/fixtures/**/*.csv
# Pliki konfiguracyjne IDE w formacie XML są dozwolone
!.idea/**/*.xml

# --- Sekrety ---
.env
.env.*
!.env.example

# --- Python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.hypothesis/

# --- IDE (PyCharm): pliki lokalne użytkownika ---
.idea/workspace.xml
.idea/shelf/
.idea/httpRequests/
.idea/dataSources/
.idea/dataSources.local.xml
.idea/usage.statistics.xml

# --- Claude Code: ustawienia lokalne ---
.claude/settings.local.json

# --- System ---
Thumbs.db
desktop.ini
.DS_Store
