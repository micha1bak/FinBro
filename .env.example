# Skopiuj do .env i wpisz własne hasło w trzech miejscach poniżej.
# Hasło: tylko litery i cyfry, bo trafia też do adresu URL połączenia.
# Plik .env nie trafia do repozytorium ani do obrazu Dockera.

# --- Baza danych (używana przez docker compose) ---
POSTGRES_USER=finbro
POSTGRES_PASSWORD=WPISZ_HASLO
POSTGRES_DB=finbro

# --- Praca deweloperska w .venv: aplikacja i testy łączą się z serwerem bazy z compose ---
# Aplikacja dev ma własną bazę finbro_dev, a testy finbro_test. Kontener aplikacji
# dostaje DATABASE_URL do bazy finbro z docker-compose.yml.
DATABASE_URL=postgresql+psycopg://finbro:WPISZ_HASLO@127.0.0.1:5432/finbro_dev
TEST_DATABASE_URL=postgresql+psycopg://finbro:WPISZ_HASLO@127.0.0.1:5432/finbro_test

